# Copy to .env.local for local dev, or set these in your host's dashboard.
# All values are public (NEXT_PUBLIC_) identifiers — never put secrets here.

# Canonical site URL, no trailing slash. Set to your real domain at deploy time.
NEXT_PUBLIC_SITE_URL=https://qtyright.com

# Contact address shown on the site and used by the contact form (mailto:).
NEXT_PUBLIC_CONTACT_EMAIL=hello@qtyright.com

# Google AdSense — leave empty until your account is approved.
# Publisher ID looks like ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
# Ad unit slot IDs (create the units in AdSense after approval):
NEXT_PUBLIC_AD_SLOT_HOME=
NEXT_PUBLIC_AD_SLOT_TOOL=
NEXT_PUBLIC_AD_SLOT_GUIDE=

# Google Analytics 4 (optional) — looks like G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=
